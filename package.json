{
  "name": "@zeropress/preview-data-validator",
  "version": "0.7.11",
  "description": "Shared ZeroPress preview data validation core",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.js",
    "./preview-data.v0.5.schema.json": "./schemas/preview-data.v0.5.schema.json",
    "./preview-data.v0.6.schema.json": "./schemas/preview-data.v0.6.schema.json",
    "./preview-data.v0.7.schema.json": "./schemas/preview-data.v0.7.schema.json",
    "./chunks": {
      "types": "./src/chunks.d.ts",
      "default": "./src/chunks.js"
    },
    "./content-policy": {
      "types": "./src/content-policy.d.ts",
      "default": "./src/content-policy.js"
    },
    "./node": {
      "types": "./src/chunks-node.d.ts",
      "default": "./src/chunks-node.js"
    }
  },
  "types": "./src/index.d.ts",
  "files": [
    "src",
    "schemas"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeropress-app/zeropress-preview-data-validator.git"
  },
  "scripts": {
    "check:schema": "node scripts/schema.js",
    "test": "npm run check:schema && node --test"
  },
  "dependencies": {
    "@zeropress/slug-policy": "0.2.2"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "devDependencies": {
    "prettier": "3.8.2",
    "prettier-plugin-sort-json": "4.2.0"
  }
}
